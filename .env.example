# --- Containers (NGSI-LD, Smart Data Model WasteContainer) ---------------
# Level 1: any NGSI-LD broker. Level 2: the provider's connector (+ DS_*).
NGSI_LD_URL=http://localhost:1026
# NGSILD_TENANT=
# CONTAINER_TYPE=WasteContainer
# @context of the data model (default: Smart Data Models, WasteManagement)
# NGSI_LD_CONTEXT=https://raw.githubusercontent.com/smart-data-models/dataModel.WasteManagement/master/context.jsonld
# Containers whose layout is optimised; the rest are only candidate sites.
TARGET_ATTRIBUTE=storedWasteKind
TARGET_VALUES=oil

# --- Level 2: data space access (ds-consumer-auth) -----------------------
# DS_ISSUER_URL=https://keycloak-<participant>.citcom-vrain-dataspace.eu/realms/provider
# DS_USERNAME=
# DS_PASSWORD=
# DS_VERIFIER_URL=https://verifier-<provider>.citcom-vrain-dataspace.eu/services/<service>
# DS_SCOPE=

# --- Area of study and population ----------------------------------------
# GeoJSON (path or URL) with the polygon(s) of the area
REGION=data/valencia_region.geojson
# "ghs" (GHS-POP, global) or a path/URL of a population GeoTIFF
POPULATION=ghs
# GHS_EPOCH=2025
CACHE_DIR=cache
# CANDIDATE_SPACING=50
# DATA_REFRESH=3600

# --- Jobs: how much of the server an optimisation may use ----------------
# JOB_WORKERS=1
# MAX_QUEUED_JOBS=5
# JOB_TIMEOUT=1800
# JOB_NICE=10
# MAX_GENERATIONS=1000
# MAX_POPULATION_SIZE=300
